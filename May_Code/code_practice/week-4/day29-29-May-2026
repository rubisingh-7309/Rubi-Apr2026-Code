## 1️⃣ Terraform
- Create EC2 (choose: c5.xlarge / r5.2xlarge / r6i.4xlarge / c6i.8xlarge / c6a.12xlarge)
- Security group
- Key pair
- EBS volume
- Output IP

provider "aws" {
  region = "eu-north-1"
}

# Key Pair 
resource "aws_key_pair" "RubiKey" {
  key_name = "keypair"
  public_key = file("rubi.pub")
}
- Security group

resource "aws_security_group" "rubi-sg" {
  name    = "rubi-sg"

  ingress = {
    from_port   = 22
    to_port     = 22
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }
   ingress = {
    from_port   = 80
    to_port     = 80
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }

  egress = {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }
}

resource "aws_instance" "rubi-EC2" {
  ami                    = "ami-0c02fb55956c7d316"
  instance_type          = "c5.xlarge"
  key_name               = aws_key_pair.RubiKey.key_name
  vpc_security_group_ids = [aws_security_group.rubi-sg.id]

  tags = {
    Name    = "rubi-EC2"
    Team    = "DevOps"
    Project = "Pathnex-Training"
    Env     = "prod"
  }
}
# - EBS volume

resource "aws_ebs_volume" "rubi-ebs" {
  availability_zone = aws_instance.rubi-EC2.availability_zone
  size = 20

  tags = {
    Name = "rubi-ebs"
  }
}

# Attach EBS

resource "aws_volume_attachment" "attach-ebs" {
  device_name = /dev/sdf
  volume_id   = aws_ebs_volume.rubi-ebs.id
  instance_id = aws_instance.rubi-EC2.id
}

# Output IP

Output "public_ip" {
  value = aws_instance.rubi-EC2.public_ip
}
## 2️⃣ Ansible
- Install nginx
- Deploy "Welcome to Pathnex" HTML page
- Start & enable service

inventory
[web]
172.31.10.100 ansible_user=ec2-user

nginx.YAML

---
- name: Configure Nginx
  hosts: web
  become: yes

  tasks:
    - name: Install nginx
      yum:
        name: nginx
        state: present
    - name: Deploy html page
      copy:
        dest: /usr/share/nginx/html/index.html
        content: |
          <html>
          <body>
          <h1> Welcome to Pathnex </h1>
          </body>
          </html>
    - name: Start nginx
      service:
        name: nginx
        state: started
        enabled: yes


## 3️⃣ Kubernetes
- Create Deployment with PVC
- Expose via NodePort

## pvc.yaml
apiVersion: v1
kind: persistentVolumeClaim
metadata: 
  name: nginx-pvc
spec:
  accessModes: 
    - ReadWriteOnce:
  resources:
    requests:     
      storage: 2Gi 


## deployment.yaml 
apiVersion: apps/v1
kind: Deployment
metadata:
  name: nginx-deployment
spec:
  replicas: 2
  selector:
    matchLabels:
      app: nginx
  template:
    metadata: 
      labels:
        app: nginx
    spec:
      - containers:
          - name: nginx
            image: nginx

            volumeMounts:
              - mountPath: /usr/share/nginx/html
                name: nginx-storage

    volumes:
      - name: nginx-storage
        persistentVolumeClaim:
          claimName: nginx-pvc
                          
## service.yaml

apiVersion: v1
kind: Service

metadata:
  name: nginx-service
spec:
  type: NodePort
  selector:
    app: nginx
  template:
    app: nginx
  ports:  
    - port: 80
      targetPort: 80
      NodePort: 3008
      
