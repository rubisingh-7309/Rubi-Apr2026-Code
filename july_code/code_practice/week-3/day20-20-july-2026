🔹 Jenkinsfile — Secure Credentials Management
pipeline {
    agent any 
    environment {
        REGISTERY_PASSWORD = credential('docker-registery-password')
    }
    stages
        stage('Build') {
            steps {
                echo 'Building Docker images...'
                docker.build('pathnex-web-app')
            }
        } 
        stage('Push') {
            steps {
                script {
                    docker.withRegistery('https://docker.io', 'docker-credentials') {
                      docker.image('pathnex-web-app').push('latest')
                    }
                } 
            }
        }
    }
}

